{
  "name": "gif-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "10.34.7"
  },
  "scripts": {
    "ops:inspect": "node scripts/operations-command.mjs inspect",
    "ops:orphans": "node scripts/operations-command.mjs orphans",
    "build:packages": "pnpm --filter \"./packages/**\" -r build",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm build:packages && pnpm -r typecheck && tsc -p tsconfig.tools.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:packages && pnpm build:decoder && vitest run",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "test:integration": "pnpm build:packages && pnpm build:decoder && pnpm --filter @gif/worker build && vitest run --config vitest.integration.config.ts",
    "db:migrate": "node scripts/database-command.mjs migrate",
    "db:seed:dev": "node scripts/database-command.mjs seed",
    "dev": "docker compose --env-file .env -f infra/compose.yaml up --build --wait",
    "stop": "docker compose --env-file .env -f infra/compose.yaml down",
    "test:smoke": "node scripts/smoke.mjs",
    "db:generate": "drizzle-kit generate --config=packages/db/drizzle.config.ts",
    "db:check": "drizzle-kit check --config=packages/db/drizzle.config.ts",
    "db:inspect:dev": "node scripts/database-command.mjs inspect",
    "db:reset": "node scripts/database-command.mjs reset",
    "api:generate": "pnpm build:packages && node scripts/generate-openapi.mjs",
    "api:check": "pnpm build:packages && node scripts/generate-openapi.mjs --check",
    "storage:provision:dev": "node scripts/provision-storage.mjs",
    "build:decoder": "node scripts/build-decoder.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.922.0",
    "@gif/contracts": "workspace:*",
    "@gif/storage": "workspace:*",
    "@gif/testing": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "@gif/config": "workspace:*"
  }
}
