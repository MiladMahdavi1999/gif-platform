# Local development placeholders only. Never reuse these credentials elsewhere.
POSTGRES_USER=gif_platform
POSTGRES_PASSWORD=local_only_database_password
POSTGRES_DB=gif_platform
DATABASE_URL=postgresql://gif_platform:local_only_database_password@db:5432/gif_platform
S3_ACCESS_KEY_ID=local_access_key
S3_SECRET_ACCESS_KEY=local_only_storage_password
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
PUBLIC_BASE_URL=http://localhost:8080
PORT=4000

# Opt-in development tooling; local HTTP API runs in development mode.
NODE_ENV=development
APP_ENV=development
ALLOW_DEV_DATABASE_COMMANDS=true
DEV_UPLOADER_EMAIL=uploader@local.test
DEV_UPLOADER_PASSWORD=local_only_uploader_password
DEV_REVIEWER_EMAIL=reviewer@local.test
DEV_REVIEWER_PASSWORD=local_only_reviewer_password

# HTTPS is required for non-development auth runtimes.
SESSION_COOKIE_NAME=gif_session
SESSION_TTL_SECONDS=86400
CSRF_ORIGIN=http://localhost:8080

# B03 Provisional local limits; originals remain private and versioned.
S3_QUARANTINE_BUCKET=gif-quarantine
S3_DERIVATIVES_BUCKET=gif-processed
MEDIA_UPLOAD_POLICY_TTL_SECONDS=600
MAX_GIF_UPLOAD_BYTES=20971520

# B04 local-only separate PostgreSQL identity. Provision after migrations/seed.
WORKER_DATABASE_URL=postgresql://gif_processing_worker:local_only_worker_database_password@db:5432/gif_platform
MEDIA_JOB_MAX_ATTEMPTS=3
MEDIA_JOB_LEASE_SECONDS=30
MEDIA_JOB_POLL_INTERVAL_MS=1000
MAX_GIF_PIXELS=16000000
MAX_GIF_DIMENSION=4096
MAX_GIF_DURATION_SECONDS=30
MAX_GIF_FRAMES=300
MAX_GIF_OUTPUT_BYTES=20971520
MEDIA_EXECUTION_TIMEOUT_MS=10000
MEDIA_JOB_TIMEOUT_MS=60000

# Separate local MinIO processing identity; provisioned by storage-worker-init.
S3_WORKER_ACCESS_KEY_ID=local_worker_access_key
S3_WORKER_SECRET_ACCESS_KEY=local_only_worker_storage_password
