{
  "openapi": "3.1.0",
  "info": { "title": "GIF Platform implemented API", "version": "0.2.0" },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "gif_session",
        "description": "Default cookie name; deployment configuration may override it. HttpOnly, SameSite=Lax, Secure on HTTPS."
      }
    }
  },
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "responses": {
          "200": {
            "description": "Process is live",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "const": "ok" }
                  },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "responses": {
          "200": {
            "description": "Dependencies ready",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ready", "not_ready"]
                    },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "database": {
                          "type": "string",
                          "enum": ["up", "down"]
                        },
                        "storage": { "type": "string", "enum": ["up", "down"] }
                      },
                      "required": ["database", "storage"]
                    }
                  },
                  "required": ["status", "checks"]
                }
              }
            }
          },
          "503": {
            "description": "Dependencies unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ready", "not_ready"]
                    },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "database": {
                          "type": "string",
                          "enum": ["up", "down"]
                        },
                        "storage": { "type": "string", "enum": ["up", "down"] }
                      },
                      "required": ["database", "storage"]
                    }
                  },
                  "required": ["status", "checks"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Exact configured Origin and application/json required. Fetch Metadata, when present, must be same-origin or none. Rate limited per account and peer IP. Replaces prior session on success.",
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "email": { "type": "string", "maxLength": 254 },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "required": ["email", "password"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated; CSRF token is bound to the session",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "email": {
                          "type": "string",
                          "format": "email",
                          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                        },
                        "roles": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": ["UPLOADER", "REVIEWER", "ADMIN"]
                          }
                        }
                      },
                      "required": ["id", "email", "roles"]
                    },
                    "csrfToken": { "type": "string" }
                  },
                  "required": ["user", "csrfToken"]
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "schema": { "type": "string" },
                "description": "Opaque session cookie with absolute expiry"
              }
            }
          },
          "400": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" },
                        "requestId": { "type": "string" }
                      },
                      "required": ["code", "message", "requestId"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "401": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" },
                        "requestId": { "type": "string" }
                      },
                      "required": ["code", "message", "requestId"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "403": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" },
                        "requestId": { "type": "string" }
                      },
                      "required": ["code", "message", "requestId"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "415": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" },
                        "requestId": { "type": "string" }
                      },
                      "required": ["code", "message", "requestId"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "429": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" },
                        "requestId": { "type": "string" }
                      },
                      "required": ["code", "message", "requestId"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "500": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" },
                        "requestId": { "type": "string" }
                      },
                      "required": ["code", "message", "requestId"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "description": "Optional cookie. Invalid, expired, revoked or disabled-user sessions return authenticated:false. Responses are never cached.",
        "responses": {
          "200": {
            "description": "Current session",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "authenticated": { "type": "boolean", "const": false }
                      },
                      "required": ["authenticated"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "authenticated": { "type": "boolean", "const": true },
                        "user": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "format": "uuid",
                              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                            },
                            "email": {
                              "type": "string",
                              "format": "email",
                              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                            },
                            "roles": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "enum": ["UPLOADER", "REVIEWER", "ADMIN"]
                              }
                            }
                          },
                          "required": ["id", "email", "roles"]
                        },
                        "csrfToken": { "type": "string" }
                      },
                      "required": ["authenticated", "user", "csrfToken"]
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" },
                        "requestId": { "type": "string" }
                      },
                      "required": ["code", "message", "requestId"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "description": "No body or an empty JSON object. Revokes server-side session and expires cookie.",
        "responses": {
          "204": { "description": "Revoked and cookie cleared" },
          "400": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
