    "/api/v1/review": {
      "get": {
        "security": [{ "sessionCookie": [] }],
        "description": "B02 reviewer authorization stub only; requires explicit REVIEWER grant.",
        "responses": {
          "200": {
            "description": "Reviewer access verified",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": { "message": { "type": "string" } },
                  "required": ["message"]
                }
              }
            }
          },
          "401": {
            "description": "Request rejected",
            "content": {
